# Node / npm
node_modules/
npm-debug.log*
pnpm-debug.log*
package-lock.json
pnpm-lock.yaml
yarn.lock

# Local secrets — never publish these
mcp/token.txt
token.txt
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build output
dist/
lib/
*.tsbuildinfo

# Shipping the artwork is load-bearing: `npm pack` and `pnpm pack` honour this
# file, and an ignore rule that swallows Assets/ silently produces an art-less
# tarball. Keep these negations last.
!Assets/
!Assets/**
